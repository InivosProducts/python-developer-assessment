# Copy these into Vercel: Project > Settings > Environment Variables (never commit real values)
MAILGUN_API_KEY=your-mailgun-private-api-key
MAILGUN_DOMAIN=sandboxXXXXXXXX.mailgun.org
MAILGUN_REGION=us
RESULTS_TO=hiring@inivosglobal.com
RESULTS_FROM=Python Assessment <postmaster@sandboxXXXXXXXX.mailgun.org>
TOKEN_SECRET=generate-a-long-random-string-at-least-32-chars
RESULTS_TIMEZONE=Asia/Colombo
SHOW_SCORE_TO_CANDIDATE=true
# Candidates confirm their email with a 6-digit code before starting. Set to "off" to disable.
EMAIL_VERIFICATION=on
# Reject addresses whose domain does not exist or cannot receive email (DNS check). Set to "off" to disable.
EMAIL_DOMAIN_CHECK=on
# Also check the mailbox exists with Mailgun Email Validation (usually a paid Mailgun feature).
MAILGUN_VALIDATION=off
# Turns on the result viewer at /admin.html for opening candidates' result files. Leave empty to keep it off.
ADMIN_PASSWORD=
